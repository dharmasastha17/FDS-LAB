        "\n",
        "import pandas as pd\n",
        "from sklearn.preprocessing import (\n",
        "    MinMaxScaler,\n",
        "    StandardScaler,\n",
        "    MaxAbsScaler,\n",
        "    RobustScaler\n",
        ")\n",
        "\n",
        "df = pd.read_csv(\"/content/winequality-red.csv\", sep=None, engine=\"python\")\n",
        "\n",
        "print(\"Original Dataset:\")\n",
        "print(df.head())\n",
        "\n",
        "print(\"\\nDataset Shape:\", df.shape)\n",
        "\n",
        "minmax = MinMaxScaler()\n",
        "minmax_df = pd.DataFrame(\n",
        "    minmax.fit_transform(df),\n",
        "    columns=df.columns\n",
        ")\n",
        "\n",
        "standard = StandardScaler()\n",
        "standard_df = pd.DataFrame(\n",
        "    standard.fit_transform(df),\n",
        "    columns=df.columns\n",
        ")\n",
        "\n",
        "maxabs = MaxAbsScaler()\n",
        "maxabs_df = pd.DataFrame(\n",
        "    maxabs.fit_transform(df),\n",
        "    columns=df.columns\n",
        ")\n",
        "\n",
        "robust = RobustScaler()\n",
        "robust_df = pd.DataFrame(\n",
        "    robust.fit_transform(df),\n",
        "    columns=df.columns\n",
        ")\n",
        "\n",
        "print(\"\\nMin-Max Normalization:\")\n",
        "print(minmax_df.head())\n",
        "\n",
        "print(\"\\nZ-Score Standardization:\")\n",
        "print(standard_df.head())\n",
        "\n",
        "print(\"\\nMax Absolute Scaling:\")\n",
        "print(maxabs_df.head())\n",
        "\n",
        "print(\"\\nRobust Scaling:\")\n",
        "print(robust_df.head())\n"
      ]
    }
