        "\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "from sklearn.preprocessing import MinMaxScaler, StandardScaler, MaxAbsScaler, RobustScaler\n",
        "\n",
        "df = pd.read_csv(\"/content/winequality-red.csv\", sep=None, engine=\"python\")\n",
        "\n",
        "print(\"Original Dataset:\")\n",
        "print(df.head())\n",
        "print(\"Dataset Shape:\", df.shape)\n",
        "\n",
        "minmax_df = pd.DataFrame(MinMaxScaler().fit_transform(df), columns=df.columns)\n",
        "standard_df = pd.DataFrame(StandardScaler().fit_transform(df), columns=df.columns)\n",
        "maxabs_df = pd.DataFrame(MaxAbsScaler().fit_transform(df), columns=df.columns)\n",
        "robust_df = pd.DataFrame(RobustScaler().fit_transform(df), columns=df.columns)\n",
        "\n",
        "datasets = {\n",
        "    \"Original\": df,\n",
        "    \"Min-Max Normalization\": minmax_df,\n",
        "    \"Z-Score Standardization\": standard_df,\n",
        "    \"Max Absolute Scaling\": maxabs_df,\n",
        "    \"Robust Scaling\": robust_df\n",
        "}\n",
        "\n",
        "for name, data in datasets.items():\n",
        "    print(\"\\n\", name)\n",
        "    print(data.head())\n",
        "\n",
        "    data.hist(figsize=(14, 10), bins=20, edgecolor=\"black\")\n",
        "    plt.suptitle(name + \" - Feature Distributions\")\n",
        "    plt.tight_layout()\n",
        "    plt.show()\n",
        "\n",
        "    plt.figure(figsize=(14, 6))\n",
        "    sns.boxplot(data=data)\n",
        "    plt.title(name + \" - Boxplot\")\n",
        "    plt.xticks(rotation=45)\n",
        "    plt.tight_layout()\n",
        "    plt.show()\n",
        "\n",
        "plt.figure(figsize=(12, 6))\n",
        "sns.kdeplot(df[\"alcohol\"], label=\"Original\")\n",
        "sns.kdeplot(minmax_df[\"alcohol\"], label=\"Min-Max\")\n",
        "sns.kdeplot(standard_df[\"alcohol\"], label=\"Standardization\")\n",
        "sns.kdeplot(maxabs_df[\"alcohol\"], label=\"MaxAbs\")\n",
        "sns.kdeplot(robust_df[\"alcohol\"], label=\"Robust\")\n",
        "plt.title(\"Comparison of Scaling Techniques - Alcohol\")\n",
        "plt.xlabel(\"Values\")\n",
        "plt.ylabel(\"Density\")\n",
        "plt.legend()\n",
        "plt.grid(True)\n",
        "plt.show()\n"
      ]
