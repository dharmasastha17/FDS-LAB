        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "df = pd.read_csv('/content/Titanic-Dataset (1).csv')\n",
        "\n",
        "age = df['Age'].dropna()\n",
        "fare = df['Fare'].dropna()\n",
        "\n",
        "plt.figure(figsize=(8,5))\n",
        "plt.hist(age, bins=20, edgecolor='black')\n",
        "plt.xlabel('Age')\n",
        "plt.ylabel('Frequency')\n",
        "plt.title('Histogram of Age')\n",
        "plt.show()\n",
        "\n",
        "\n",
        "plt.figure(figsize=(8,5))\n",
        "sns.histplot(age, bins=20, kde=True)\n",
        "plt.xlabel('Age')\n",
        "plt.ylabel('Frequency')\n",
        "plt.title('Age Distribution with KDE')\n",
        "plt.show()\n",
        "\n",
        "\n",
        "plt.figure(figsize=(8,5))\n",
        "sns.histplot(fare, bins=30, kde=True)\n",
        "plt.xlabel('Fare')\n",
        "plt.ylabel('Frequency')\n",
        "plt.title('Fare Distribution with KDE')\n",
        "plt.show()\n",
        "\n",
        "\n",
        "plt.figure(figsize=(8,4))\n",
        "sns.boxplot(x=age)\n",
        "plt.xlabel('Age')\n",
        "plt.title('Box Plot of Age')\n",
        "plt.show()\n",
        "\n",
        "\n",
        "plt.figure(figsize=(8,4))\n",
        "sns.boxplot(x=fare)\n",
        "plt.xlabel('Fare')\n",
        "plt.title('Box Plot of Fare')\n",
        "plt.show()\n",
        "\n",
        "\n",
        "print(\"Age Skewness:\", age.skew())\n",
        "print(\"Fare Skewness:\", fare.skew())\n",
        "\n",
        "\n",
        "print(\"\\nAge:\")\n",
        "print(\"Mean =\", age.mean())\n",
        "print(\"Median =\", age.median())\n",
        "print(\"Mode =\", age.mode()[0])\n",
        "\n",
        "print(\"\\nFare:\")\n",
        "print(\"Mean =\", fare.mean())\n",
        "print(\"Median =\", fare.median())\n",
        "print(\"Mode =\", fare.mode()[0])"
      ]
