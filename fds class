      "source": [
        "import pandas as pd\n",
        "import numpy as np\n",
        "\n",
        "student_ids = np.arange(1001, 1016)\n",
        "\n",
        "student_names = [f'Student_{i}' for i in range(1, 16)]\n",
        "\n",
        "marks_data = np.random.randint(40, 101, size=(15, 5))\n",
        "\n",
        "subjects = ['Math', 'Science', 'English', 'History', 'Art']\n",
        "\n",
        "data = {\n",
        "    'Student ID': student_ids,\n",
        "    'Name': student_names\n",
        "}\n",
        "\n",
        "for i, subject in enumerate(subjects):\n",
        "    data[subject] = marks_data[:, i]\n",
        "\n",
        "student_df = pd.DataFrame(data)\n",
        "\n",
        "\n",
        "display(student_df.head())"
      ],
